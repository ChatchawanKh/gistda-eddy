# ------------------------------------------------------------------
# คัดลอกไฟล์นี้เป็น .env แล้วตั้งค่าตามเครื่อง/สภาพแวดล้อมจริง
# ห้าม commit ไฟล์ .env จริงขึ้น Git (.gitignore กันไว้แล้ว)
# ------------------------------------------------------------------

# --- Server ---
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173
# ตั้งเมื่อรันหลัง reverse proxy (nginx ฯลฯ) เพื่อให้ rate limit เห็น IP จริงของผู้ใช้ เช่น 1 = proxy 1 ชั้น
# TRUST_PROXY=1

# --- PostgreSQL (PG Admin 17) ---
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=gistda_fluxsuite

# --- JWT ---
# ต้องเป็นค่าสุ่มยาวอย่างน้อย 32 ตัวอักษร และ access/refresh ต้องไม่ซ้ำกัน (server จะไม่ยอม start ถ้าไม่ผ่าน)
# สร้างด้วย: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# --- "จดจำการเข้าสู่ระบบ" (remember me) ---
# ติ๊ก remember me ตอน login -> ใช้ REMEMBER_ME_EXPIRES_IN (cookie อยู่ข้ามการปิดเบราว์เซอร์)
# ไม่ติ๊ก -> ใช้ SESSION_EXPIRES_IN (cookie เป็น session cookie หายเมื่อปิดเบราว์เซอร์)
REMEMBER_ME_EXPIRES_IN=30d
SESSION_EXPIRES_IN=1d

# --- Email domain restriction ---
# ระหว่างพัฒนา: false (อนุญาตทุกอีเมล) | ตอนขึ้นระบบจริง: true (บังคับ @gistda.or.th)
ENFORCE_EMAIL_DOMAIN=false
ALLOWED_EMAIL_DOMAIN=gistda.or.th

# --- SMTP (สำหรับส่งอีเมล reset password) ---
# ถ้ายังไม่ตั้งค่า (เว้นว่างไว้) ระบบจะ log ลิงก์ reset ลง console แทน เพื่อให้ทดสอบได้ทันทีตอน dev
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="GISTDA-FLUXSUITE <no-reply@gistda.or.th>"
